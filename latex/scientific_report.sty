\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{scientific_report}[2024/01/01 Scientific Report Style]

% ============================================================================
% REQUIRED PACKAGES
% ============================================================================

% Page layout and geometry
\RequirePackage[margin=1in,headheight=14pt]{geometry}
\RequirePackage{setspace}

% Typography - Helvetica font family
\RequirePackage{helvet}
\renewcommand{\familydefault}{\sfdefault}

% Colors and graphics
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{tikz}

% Tables
\RequirePackage{longtable}
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{tabularx}

% Lists and formatting
\RequirePackage{enumitem}
\RequirePackage{parskip}

% Boxes and callouts
\RequirePackage[most]{tcolorbox}

% Headers and footers
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}

% Hyperlinks and references
\RequirePackage{hyperref}
\RequirePackage[numbers,sort&compress]{natbib}

% Math and scientific notation
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{siunitx}

% Captions
\RequirePackage{caption}
\RequirePackage{subcaption}

% ============================================================================
% COLOR DEFINITIONS - PROFESSIONAL SCIENTIFIC PALETTE
% ============================================================================

% Primary colors (professional blue palette)
\definecolor{primaryblue}{RGB}{0, 51, 102}
\definecolor{secondaryblue}{RGB}{74, 144, 226}
\definecolor{lightblue}{RGB}{220, 235, 252}
\definecolor{accentblue}{RGB}{0, 120, 215}

% Scientific accent colors
\definecolor{sciencegreen}{RGB}{0, 168, 150}
\definecolor{lightgreen}{RGB}{220, 245, 240}
\definecolor{darkgreen}{RGB}{0, 128, 96}

% Warning and caution colors
\definecolor{cautionorange}{RGB}{255, 140, 66}
\definecolor{lightorange}{RGB}{255, 243, 224}
\definecolor{criticalred}{RGB}{198, 40, 40}
\definecolor{lightred}{RGB}{255, 235, 238}

% Recommendation and action colors
\definecolor{recommendpurple}{RGB}{103, 58, 183}
\definecolor{lightpurple}{RGB}{237, 231, 246}

% Neutral colors
\definecolor{darkgray}{RGB}{66, 66, 66}
\definecolor{mediumgray}{RGB}{117, 117, 117}
\definecolor{lightgray}{RGB}{245, 245, 245}
\definecolor{tablealt}{RGB}{248, 250, 252}
\definecolor{tableborder}{RGB}{200, 200, 200}

% ============================================================================
% HYPERLINK CONFIGURATION
% ============================================================================

\hypersetup{
    colorlinks=true,
    linkcolor=primaryblue,
    filecolor=primaryblue,
    urlcolor=accentblue,
    citecolor=secondaryblue,
    pdftitle={Scientific Report},
    pdfauthor={},
    pdfsubject={Scientific Research}
}

% ============================================================================
% CHAPTER AND SECTION FORMATTING
% ============================================================================

\titleformat{\chapter}[display]
{\normalfont\huge\bfseries\color{primaryblue}}
{\chaptertitlename\ \thechapter}{20pt}{\Huge}
\titlespacing*{\chapter}{0pt}{-20pt}{40pt}

\titleformat{\section}
{\normalfont\Large\bfseries\color{primaryblue}}
{\thesection}{1em}{}
\titlespacing*{\section}{0pt}{3.5ex plus 1ex minus .2ex}{2.3ex plus .2ex}

\titleformat{\subsection}
{\normalfont\large\bfseries\color{secondaryblue}}
{\thesubsection}{1em}{}

\titleformat{\subsubsection}
{\normalfont\normalsize\bfseries\color{darkgray}}
{\thesubsubsection}{1em}{}

\titleformat{\paragraph}[runin]
{\normalfont\normalsize\bfseries\color{darkgray}}
{\theparagraph}{1em}{}

% ============================================================================
% HEADER AND FOOTER CONFIGURATION
% ============================================================================

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textit{\leftmark}}
\fancyhead[R]{\small\textit{Scientific Report}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{primaryblue}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrule}{\hbox to\headwidth{\color{lightgray}\leaders\hrule height \footrulewidth\hfill}}

\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[C]{\thepage}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0.4pt}
}

